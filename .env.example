# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/zap_db?sslmode=require

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://default:password@host:6379

# ─── Lightning provider ───────────────────────────────────────────────────────
# LNBITS | LND
LIGHTNING_PROVIDER=LNBITS

# LNbits (used when LIGHTNING_PROVIDER=LNBITS)
LNBITS_BASE_URL=https://demo.lnbits.com
LNBITS_INVOICE_KEY=your_invoice_key_here
# Required for payout (outgoing payments) — uses admin key with higher permissions
LNBITS_ADMIN_KEY=your_admin_key_here

# LND REST (used when LIGHTNING_PROVIDER=LND)
# LND_BASE_URL=https://your-lnd-node:8080
# LND_MACAROON_HEX=your_macaroon_hex_here
# LND_TLS_CERT_BASE64=base64_encoded_tls_cert
# LND_WEBHOOK_SECRET=optional_hmac_secret_for_webhook_bridge

# ─── Secrets (generate with: openssl rand -hex 32) ───────────────────────────
PUBLISHER_JWT_SECRET=replace_with_64_char_hex
READER_JWT_SECRET=replace_with_64_char_hex
INTERNAL_API_SECRET=replace_with_64_char_hex

# ─── Invoice / access token settings ─────────────────────────────────────────
ACCESS_TOKEN_TTL_HOURS=24
INVOICE_EXPIRY_SECONDS=3600

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Publicly reachable URL for this API — used to register LNbits webhooks.
# For local dev, set this to your ngrok URL (see README).
# Leave empty to disable webhook registration (polling-only mode).
WEBHOOK_BASE_URL=

# ─── Frontend CORS ────────────────────────────────────────────────────────────
# Allow the frontend origin to send credentialed requests.
FRONTEND_URL=http://localhost:3000
